# Liste séparée par des virgules ; aucun slash final.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optionnel : chemin absolu ou relatif à la racine du dépôt backend.
# MODEL_PATH=../CardioScope-DATA-ML/artifacts/pipeline.joblib
# Options de scripts/run.sh ; accès local par défaut.
# HOST=127.0.0.1
# PORT=8000

# PostgreSQL : valeurs injectees par Compose, pas de secret dans Git.
# Le code ne charge pas automatiquement .env : exporter ces variables hors Docker.
DB_HOST=db
DB_PORT=5432
DB_NAME=cardioscope
DB_USER=cardioscope
DB_PASSWORD=
